         std::unique_ptr<oscpkt::PacketWriter> pw;

  std::unique_ptr<AuxTaskNonRT> send_task;
  void send_task_func(void* buf, int size);
};
# 6 "/root/Bela/projects/ORATORIO_TRIL_O2O/main.cpp" 2

const int MAX_SENSORS = 6;
Trill* gTouchSensors[MAX_SENSORS] = {nullptr};
int gNumSensors = 0;

OscSender oscSender;
int remotePort = 6901;
const char* remoteIp = "192.168.7.1";

unsigned int gSampleCount = 0;
float gSendInterval = 0.1;
unsigned int gSendIntervalSamples;
const unsigned int i2cBus = 1;
const unsigned int gI2cBus = 1;

struct Display {U8G2 d; int mux;};
Display gDisplay = { U8G2_SSD1306_128X64_NONAME_F_HW_I2C_LINUX((&u8g2_cb_r0), gI2cBus, 0x3c), -1};


float sensorValues[MAX_SENSORS] = {0};
bool displayNeedsUpdate = false;


void readLoop(void*)
{
 while(!Bela_stopRequested())
 {
  for(int n = 0; n < gNumSensors; ++n)
  {
   if(gTouchSensors[n])
    gTouchSensors[n]->readI2C();
  }
  usleep(50000);
 }
}


void updateDisplay() {
 U8G2& u8g2 = gDisplay.d;
 u8g2.clearBuffer();

 if(gNumSensors == 0) {
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(10, 32, "No sensors");
  u8g2.sendBuffer();
  return;
 }

 u8g2.setFont(u8g2_font_4x6_tf);
 u8g2.setFontRefHeightText();

 int sectionHeight = 64 / gNumSensors;


 for(int s = 0; s < gNumSensors; s++) {
  int yBase = s * sectionHeight;


  u8g2.drawFrame(0, yBase + 2, 128, sectionHeight - 4);


  int barWidth = (int)(sensorValues[s] * 126);
  if(barWidth > 0) {
   u8g2.drawBox(1, yBase + 3, barWidth, sectionHeight - 6);
  }


  char label[8];
  snprintf(label, sizeof(label), "%d", s);
  u8g2.drawStr(130, yBase + sectionHeight/2 + 2, label);
 }

 u8g2.sendBuffer();
}


void displayLoop(void*)
{
 while(!Bela_stopRequested())
 {
  if(displayNeedsUpdate)
  {
   displayNeedsUpdate = false;
   updateDisplay();
  }
  usleep(100000);
 }
}


bool setup(BelaContext *context, void *userData)
{
 U8G2& u8g2 = gDisplay.d;
 u8g2.initDisplay();
 u8g2.setPowerSave(0);
 u8g2.clearBuffer();
 u8g2.setFont(u8g2_font_6x10_tf);
 u8g2.drawStr(10, 32, "Initializing...");
 u8g2.sendBuffer();

 oscSender.setup(remotePort, remoteIp);


 for(uint8_t addr = 0x20; addr <= 0x50 && gNumSensors < MAX_SENSORS; ++addr)
 {
  if(addr == 0x3c)
   continue;

  Trill::Device device = Trill::probe(i2cBus, addr);
  if(Trill::NONE != device && Trill::CRAFT != device)
  {
   gTouchSensors[gNumSensors] = new Trill(i2cBus, device, addr);
   gTouchSensors[gNumSensors]->printDetails();
   gNumSensors++;
  }
 }

 Bela_runAuxiliaryTask(readLoop);
 Bela_runAuxiliaryTask(displayLoop);
 gSendIntervalSamples = context->audioSampleRate * gSendInterval;

 return true;
}

void render(BelaContext *context, void *userData)
{
 for(unsigned int n = 0; n < context->audioFrames; ++n)
 {
  gSampleCount++;

  if(gSampleCount == gSendIntervalSamples)
  {
   gSampleCount = 0;
   float arr[3];

   for(int t = 0; t < gNumSensors; ++t) {
    arr[0] = gTouchSensors[t]->compoundTouchSize();
    arr[1] = gTouchSensors[t]->compoundTouchLocation();
    arr[2] = gTouchSensors[t]->compoundTouchHorizontalLocation();
    rt_printf("[%d] %2.3f %.3f %.3f  ", t, arr[0], arr[1], arr[2]);
    oscSender.newMessage("/trill").add((int)t).add((float) arr[0]).add((float)arr[1]).add((float)arr[2]).send();


    sensorValues[t] = arr[1];
   }
   rt_printf("\n");

   displayNeedsUpdate = true;
  }
 }
}

void cleanup(BelaContext *context, void *userData)
{

 U8G2& u8g2 = gDisplay.d;
 u8g2.clearBuffer();
 u8g2.sendBuffer();
 u8g2.setPowerSave(1);


 for(int i = 0; i < gNumSensors; i++)
  if(gTouchSensors[i])
   delete gTouchSensors[i];
}
