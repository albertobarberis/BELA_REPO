      ((&u8x8))->pins[18] = ((val)); }
    void setMenuNextPin(uint8_t val) {
      ((&u8x8))->pins[17] = ((val)); }
    void setMenuUpPin(uint8_t val) {
      ((&u8x8))->pins[20] = ((val)); }
    void setMenuDownPin(uint8_t val) {
      ((&u8x8))->pins[21] = ((val)); }
    void setMenuHomePin(uint8_t val) {
      ((&u8x8))->pins[19] = ((val)); }


