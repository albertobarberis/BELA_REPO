    int8_t getFontAscent(void) { return ((&u8g2)->font_ref_ascent); }
    int8_t getFontDescent(void) { return ((&u8g2)->font_ref_descent); }
    int8_t getMaxCharHeight(void) { return ((&u8g2)->font_info.max_char_height); }
    int8_t getMaxCharWidth(void) { return ((&u8g2)->font_info.max_char_width); }
    u8g2_uint_t getHeight() { return ((&u8g2)->height); }
    u8g2_uint_t getWidth() { return ((&u8g2)->width); }
